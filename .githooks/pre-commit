#!/bin/sh
#
# pre-commit 钩子：提交前扫描敏感信息
#
# 启用方式（在仓库根目录执行一次）：
#   git config core.hooksPath .githooks
#
# 设计原则：
#   - 找到可用的 Python 才扫描；找不到就**放行并提示**，不阻断提交。
#     原因：Windows 上 python 常常只是 Microsoft Store 的占位程序，
#     直接调用会输出「Python was not found」并返回非 0，从而误拦正常提交。
#   - 真正扫描到敏感信息时一律阻断。
#
# 跳过方式（仅在确认无敏感信息时使用）：
#   git commit --no-verify

if [ ! -f scan_secrets.py ]; then
  echo "[pre-commit] 未找到 scan_secrets.py，跳过敏感信息扫描"
  exit 0
fi

# ---------- 寻找一个真正可用的 Python ----------
# 逐个候选执行 `-c "print(1)"`，能输出 1 才算可用（可排除 Store 占位程序）
find_python() {
  for candidate in py python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      if output=$("$candidate" -c "print(1)" 2>/dev/null) && [ "$output" = "1" ]; then
        echo "$candidate"
        return 0
      fi
    fi
  done
  return 1
}

PYTHON=$(find_python)

if [ -z "$PYTHON" ]; then
  echo "[pre-commit] 未找到可用的 Python，跳过敏感信息扫描"
  echo "[pre-commit] 建议手动确认：没有把密钥写进源码；或安装 Python 后重试"
  exit 0
fi

echo "[pre-commit] 使用 $PYTHON 扫描敏感信息..."

"$PYTHON" scan_secrets.py
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "[pre-commit] 提交已被阻断：请移除上述敏感信息，"
  echo "[pre-commit] 或将真实配置移入 .env.local（该文件已被 .gitignore 忽略）。"
  exit 1
fi

exit 0
