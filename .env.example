# 环境变量模板 —— 复制为 .env.local 后填入真实值
#
#   cp .env.example .env.local
#
# ⚠️ 安全规则（务必阅读）
# ─────────────────────────────────────────────────────────────
# 1. VITE_ 前缀的变量会被打包进前端产物，可在浏览器中查看。
#    所以只能放「设计上就公开」的值：Supabase 项目 URL + anon(publishable) key。
# 2. service_role key 拥有【绕过 RLS 的完全权限】，等同于数据库最高权限。
#    它绝不能出现在前端，绝不能以 VITE_ 开头，绝不能提交到仓库。
#    只配置在：Supabase Edge Function Secrets / 部署平台环境变量。
# 3. anon key 是否安全，完全取决于 RLS 是否正确配置。
#    任何一张表漏开 RLS，该表就会对全互联网开放。
# ─────────────────────────────────────────────────────────────

# ---------- 前端可公开 ----------
# Supabase 项目 URL，形如 https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase anon / publishable key（设计上公开，权限受 RLS 约束）
VITE_SUPABASE_ANON_KEY=

# 运行环境：local | staging | production
VITE_APP_ENV=local

# 站点标题
VITE_APP_TITLE=青阅循环


# ---------- 仅服务端 / Edge Functions 使用（不要填在这里）----------
# 以下变量不在此文件配置，仅作为清单提示：
#
#   SUPABASE_SERVICE_ROLE_KEY   Supabase 后台 → Project Settings → API → service_role
#   SUPABASE_DB_PASSWORD        Supabase 后台 → Project Settings → Database
#   SUPABASE_JWT_SECRET         Supabase 后台 → Project Settings → API → JWT Settings
#
# 数据库连接串格式（密码请自行在后台获取，不要写入文档）：
#   postgresql://postgres:<DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
